DIAS_ENVIRONMENT=development
DIAS_FRONTEND_ORIGIN=http://localhost:3000
# Production deployments use PostgreSQL. Leave blank to use local SQLite.
DIAS_DATABASE_URL=
DIAS_DATABASE_PATH=/data/incidents.sqlite3
DIAS_STORAGE_PATH=/data/uploads
DIAS_INTEGRATIONS_MODE=mock
DIAS_SESSION_COOKIE_SECURE=false
# Configure both values to enable real OpenRouter reasoning. Never commit the key.
DIAS_OPENROUTER_API_KEY=
DIAS_OPENROUTER_EXTRACTION_MODEL=
DIAS_OPENROUTER_REASONING_MODEL=
# Set official mode only after the Slack app has been installed in the target workspace.
# The bot needs chat:write and must be invited to DIAS_SLACK_DEFAULT_CHANNEL.
# Use a channel ID (C...) so a channel rename cannot redirect incident messages.
DIAS_SLACK_DEFAULT_CHANNEL=C0123456789
DIAS_SLACK_DEFAULT_CHANNEL_NAME=incident-response
# Official integration mode additionally requires OAuth-derived server-side secrets:
DIAS_SLACK_BOT_TOKEN=
DIAS_JIRA_ACCESS_TOKEN=
DIAS_JIRA_CLOUD_ID=
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# On the hosted web project, leave NEXT_PUBLIC_API_URL unset and set API_ORIGIN
# to the API project's Vercel URL, without a trailing slash.
API_ORIGIN=
